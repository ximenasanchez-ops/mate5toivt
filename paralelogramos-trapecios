.opcion-imagen svg{width:100%;height:auto;}
.opcion-imagen p{text-align:center;margin:.3rem 0 0;font-weight:700;}

/* -------- arrastrar etiqueta a la figura -------- */
.etiquetas-pool{display:flex;flex-wrap:wrap;gap:.7rem;justify-content:center;margin:.8rem 0;}
.etiqueta{
  touch-action:none; user-select:none;
  background:var(--primary);color:#fff;font-weight:700;padding:.75em 1.1em;border-radius:16px;
  cursor:grab; box-shadow:0 4px 0 var(--primary-dark); font-size:1.05em;
}
.etiqueta:active{cursor:grabbing;}
.etiqueta.dragging{position:fixed;z-index:200;opacity:.92;pointer-events:none;}
.etiqueta.colocada{opacity:.3;cursor:default;box-shadow:none;}
.zona-figura{position:relative;display:flex;justify-content:center;margin:.6rem 0;}
.zona-suelta{
  position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
  width:150px;height:64px;border:4px dashed var(--border);border-radius:16px;
  display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--muted);
  background:rgba(255,255,255,.75);
}
.zona-suelta.sobre{border-color:var(--accent);background:#e0f7e9;}
.zona-suelta.llena{border-style:solid;border-color:var(--accent);color:var(--accent-dark);background:#e0f7e9;}

/* -------- clasificar en cajas -------- */
.cajas-wrap{display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;margin-top:1rem;}
.caja{
  flex:1;min-width:150px;min-height:150px;border:4px dashed var(--border);border-radius:16px;
  background:#f4f8ff;padding:.6rem;text-align:center;
}
body.alto-contraste .caja{background:#111;}
.caja h3{margin:.2rem 0 .5rem;color:var(--primary-dark);}
body.alto-contraste .caja h3{color:var(--primary);}
.caja.sobre{border-color:var(--accent);background:#e0f7e9;}
.figuras-pool{display:flex;flex-wrap:wrap;gap:.8rem;justify-content:center;margin:.8rem 0;}
.figura-chip{
  touch-action:none;user-select:none;cursor:grab;
  background:var(--panel);border:3px solid var(--border);border-radius:14px;padding:.4rem;width:90px;
}
.figura-chip.dragging{position:fixed;z-index:200;opacity:.92;pointer-events:none;}
.figura-chip.colocada{opacity:.3;cursor:default;}
.figura-chip svg{width:100%;height:auto;}

/* -------- unir con líneas (click-click) -------- */
.match-wrap{display:flex;gap:1.4rem;justify-content:space-between;flex-wrap:wrap;}
.match-col{flex:1;min-width:130px;display:flex;flex-direction:column;gap:.6rem;}
.match-item{
  background:var(--panel);border:3px solid var(--border);border-radius:14px;padding:.7em .8em;
  text-align:center;font-weight:700;cursor:pointer;font-size:.98em;
}
.match-item[aria-pressed="true"]{border-color:var(--primary);background:#eaf1ff;}
.match-item.ok{border-color:var(--accent);background:#e0f7e9;opacity:.7;cursor:default;}
.match-item.bad{border-color:var(--danger);}
.match-item svg{width:80px;height:auto;}

/* -------- resaltar lados paralelos -------- */
.lado-clickable{cursor:pointer;}
.lado-seleccionado{stroke:var(--warn) !important; stroke-width:7 !important;}
.lado-correcto{stroke:var(--accent) !important; stroke-width:7 !important;}

/* ============================================================
   4. PANTALLA FINAL
   ============================================================ */
#final-carita{font-size:3.5rem;text-align:center;}
