@keyframes pop{0%{transform:scale(1);}45%{transform:scale(1.08);}100%{transform:scale(1);}}
.pop{animation:pop .3s ease;}
@keyframes shake{0%,100%{transform:translateX(0);}25%{transform:translateX(-7px);}75%{transform:translateX(7px);}}
.shake{animation:shake .3s ease;}

/* -------- opciones grandes (completar / elegir imagen) -------- */
.opciones{display:flex;flex-wrap:wrap;gap:.7rem;justify-content:center;margin:.8rem 0;}
.opcion-btn{
  background:var(--panel);border:3px solid var(--primary);color:var(--primary-dark);
  border-radius:14px;padding:.8em 1.1em;font-weight:700;font-size:1.05em;min-width:110px;
}
.opcion-btn:hover{background:#eaf1ff;}
.opcion-btn.correcta{background:var(--accent);border-color:var(--accent-dark);color:#fff;}
