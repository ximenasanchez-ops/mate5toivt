// --- Tarjeta: elegir imagen (¿cuál tiene 2 pares de lados paralelos?) ---
function tarjetaElegirImagen(idTarjeta){
  return function(container){
    const consigna = '¿Cuál de estas figuras tiene dos pares de lados que van igual (paralelos)?';
    // 1 paralelogramo (correcto) + 2 trapecios (incorrectos), orden al azar
    const paralelogramos = LISTA_FIGURAS.filter(k=>FIGURAS[k].grupo==='Paralelogramo');
    const trapecios = LISTA_FIGURAS.filter(k=>FIGURAS[k].grupo==='Trapecio');
    const correctaId = paralelogramos[Math.floor(Math.random()*paralelogramos.length)];
    const incorrectas = trapecios.slice().sort(()=>Math.random()-0.5).slice(0,2);
    const opciones = [correctaId, ...incorrectas].sort(()=>Math.random()-0.5);

    container.innerHTML = `
      <h2>Actividad: Mirar y elegir</h2>
      <p class="consigna">${consigna}</p>
      <div class="opciones-imagen" id="opts-${idTarjeta}"></div>
      <div class="actions-row">
        <button class="btn-outline" data-a="escuchar">🔊 Escuchar</button>
        <button class="btn-outline" data-a="pista">💡 Pista (<span data-hl>2</span>)</button>
      </div>
      <div class="feedback" id="fb-${idTarjeta}" role="status" aria-live="polite"></div>
    `;
    const opts = container.querySelector(`#opts-${idTarjeta}`);
    opciones.forEach(idF=>{
      const div=document.createElement('div');
      div.className='opcion-imagen'; div.tabIndex=0; div.setAttribute('role','button');
      div.innerHTML = dibujarFiguraSVG(idF) + `<p>${FIGURAS[idF].nombre}</p>`;
      div.setAttribute('aria-label', `Elegir ${FIGURAS[idF].nombre}`);
      opts.appendChild(div);
    });
    const fb = container.querySelector(`#fb-${idTarjeta}`);
    let pistasUsadas=0, resuelto=false;
    hablar(consigna);

    function elegir(idF, el){
      if(resuelto) return;
      if(idF===correctaId){
        el.classList.add('correcta');
        mostrarFeedback(fb,'ok','¡Perfecto! Esa figura tiene dos pares de lados paralelos.');
        resuelto=true;
        marcarCompletada(idTarjeta);
        habilitarBotonSiguiente(container);
      } else {
        el.classList.add('incorrecta');
        mostrarFeedback(fb,'bad','Esa no es. Mirá otra vez los lados.');
        setTimeout(()=>el.classList.remove('incorrecta'), 700);
      }
    }
    [...opts.children].forEach((el,i)=>{
      const idF = opciones[i];
      el.addEventListener('click', ()=>elegir(idF, el));
      el.addEventListener('keydown', e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); elegir(idF, el);} });
    });
    container.querySelector('[data-a="escuchar"]').addEventListener('click', ()=> hablar(consigna));
    container.querySelector('[data-a="pista"]').addEventListener('click', ()=>{
      if(pistasUsadas>=2){ mostrarFeedback(fb,'hint','Ya usaste las 2 pistas.'); return; }
      const texto = pistasUsadas===0 ? 'Buscá la figura que NO es un trapecio.' : `Se llama ${FIGURAS[correctaId].nombre}.`;
      mostrarFeedback(fb,'hint', texto);
      pistasUsadas++; container.querySelector('[data-hl]').textContent=(2-pistasUsadas);
    });
  };
}

// --- Tarjeta: clasificar arrastrando a 2 cajas ---
function tarjetaClasificar(idTarjeta){
  return function(container){
    const consigna = 'Arrastra cada figura a su caja: Paralelogramo o Trapecio.';
    const elegidas = [
      LISTA_FIGURAS.filter(k=>FIGURAS[k].grupo==='Paralelogramo')[Math.floor(Math.random()*4)],
      LISTA_FIGURAS.filter(k=>FIGURAS[k].grupo==='Paralelogramo')[Math.floor(Math.random()*4)],
      LISTA_FIGURAS.filter(k=>FIGURAS[k].grupo==='Trapecio')[Math.floor(Math.random()*3)],
      LISTA_FIGURAS.filter(k=>FIGURAS[k].grupo==='Trapecio')[Math.floor(Math.random()*3)],
    ];
    container.innerHTML = `
      <h2>Actividad: Clasificar</h2>
      <p class="consigna">${consigna}</p>
      <div class="figuras-pool" id="pool-${idTarjeta}"></div>
      <div class="cajas-wrap">
        <div class="caja dnd-destino" data-grupo="Paralelogramo" data-lleno="0" aria-label="Caja Paralelogramo"><h3>Paralelogramo</h3></div>
        <div class="caja dnd-destino" data-grupo="Trapecio" data-lleno="0" aria-label="Caja Trapecio"><h3>Trapecio</h3></div>
      </div>
      <div class="actions-row">
        <button class="btn-outline" data-a="escuchar">🔊 Escuchar</button>
        <button class="btn-outline" data-a="pista">💡 Pista (<span data-hl>2</span>)</button>
      </div>
      <div class="feedback" id="fb-${idTarjeta}" role="status" aria-live="polite"></div>
    `;
    const pool = container.querySelector(`#pool-${idTarjeta}`);
    elegidas.forEach((idF,i)=>{
      const chip=document.createElement('div');
      chip.className='figura-chip'; chip.dataset.figura=idF; chip.dataset.colocado='0'; chip.dataset.id=i;
      chip.innerHTML = dibujarFiguraSVG(idF);
      chip.setAttribute('aria-label', FIGURAS[idF].nombre);
      pool.appendChild(chip);
    });
    const fb = container.querySelector(`#fb-${idTarjeta}`);
    let pistasUsadas=0, correctos=0;
    hablar(consigna);

    // Las cajas no usan la clase .zona-suelta sino .dnd-destino (ya definida arriba)
    container.querySelectorAll('.figura-chip').forEach(el=>{
      el.addEventListener('pointerdown', (e)=>{
        if(el.dataset.colocado==='1') return;
        const rect=el.getBoundingClientRect();
        const offsetX=e.clientX-rect.left, offsetY=e.clientY-rect.top;
        el.setPointerCapture(e.pointerId);
        el.classList.add('dragging'); el.style.width=rect.width+'px';
        el.style.left=rect.left+'px'; el.style.top=rect.top+'px';
        function mover(ev){
          el.style.left=(ev.clientX-offsetX)+'px'; el.style.top=(ev.clientY-offsetY)+'px';
          container.querySelectorAll('.caja').forEach(c=>c.classList.remove('sobre'));
          const bajo=document.elementFromPoint(ev.clientX,ev.clientY);
          const caja=bajo&&bajo.closest?bajo.closest('.caja'):null;
          if(caja) caja.classList.add('sobre');
        }
        function soltar(ev){
          document.removeEventListener('pointermove',mover);
          document.removeEventListener('pointerup',soltar);
          el.classList.remove('dragging'); el.style.position=''; el.style.left=''; el.style.top=''; el.style.width='';
          container.querySelectorAll('.caja').forEach(c=>c.classList.remove('sobre'));
          const bajo=document.elementFromPoint(ev.clientX,ev.clientY);
          const caja=bajo&&bajo.closest?bajo.closest('.caja'):null;
          if(caja){
            const idF=el.dataset.figura;
            if(FIGURAS[idF].grupo === caja.dataset.grupo){
              caja.appendChild(el); el.dataset.colocado='1'; el.classList.add('colocada');
              correctos++;
              mostrarFeedback(fb,'ok', `¡Muy bien! (${correctos}/${elegidas.length})`);
              if(correctos===elegidas.length){ marcarCompletada(idTarjeta); habilitarBotonSiguiente(container); }
            } else {
              mostrarFeedback(fb,'bad','Esa caja no es. Mirá cuántos pares de lados iguales tiene.');
            }
          }
        }
        document.addEventListener('pointermove',mover);
        document.addEventListener('pointerup',soltar);
      });
      el.tabIndex=0; el.setAttribute('role','button');
    });

    container.querySelector('[data-a="escuchar"]').addEventListener('click', ()=> hablar(consigna));
    container.querySelector('[data-a="pista"]').addEventListener('click', ()=>{
      if(pistasUsadas>=2){ mostrarFeedback(fb,'hint','Ya usaste las 2 pistas.'); return; }
      const texto = pistasUsadas===0
        ? 'Si tiene 2 pares de lados iguales, va en Paralelogramo. Si tiene 1 par, va en Trapecio.'
        : 'Contá los pares de lados que van en la misma dirección.';
      mostrarFeedback(fb,'hint', texto);
      pistasUsadas++; container.querySelector('[data-hl]').textContent=(2-pistasUsadas);
    });
  };
}

