// --- Tarjeta: resaltar/marcar lados paralelos tocando la figura ---
function tarjetaResaltarLados(idTarjeta){
  return function(container){
    const idF = LISTA_FIGURAS[Math.floor(Math.random()*LISTA_FIGURAS.length)];
    const fig = FIGURAS[idF];
    const consigna = 'Toca dos lados que van en la misma dirección (paralelos). Se van a pintar de verde si aciertas.';
    container.innerHTML = `
      <h2>Actividad: Marcar lados paralelos</h2>
      <p class="consigna">${consigna}</p>
      <div id="figwrap-${idTarjeta}">${dibujarFiguraSVG(idF, {ladosClickables:true})}</div>
      <p id="cuenta-${idTarjeta}" style="text-align:center;font-weight:700;">Pares encontrados: 0 de ${fig.paresParalelos.length}</p>
      <div class="actions-row">
        <button class="btn-outline" data-a="escuchar">🔊 Escuchar</button>
        <button class="btn-outline" data-a="pista">💡 Pista (<span data-hl>2</span>)</button>
      </div>
      <div class="feedback" id="fb-${idTarjeta}" role="status" aria-live="polite"></div>
    `;
    const svg = container.querySelector(`#figwrap-${idTarjeta} svg`);
    const fb = container.querySelector(`#fb-${idTarjeta}`);
    const cuentaEl = container.querySelector(`#cuenta-${idTarjeta}`);
    let seleccionado=null, encontrados=0, pistasUsadas=0;
    hablar(consigna);

    svg.querySelectorAll('.lado-clickable').forEach(lado=>{
      lado.tabIndex=0; lado.setAttribute('role','button');
      lado.setAttribute('aria-label', 'Lado '+lado.dataset.lado);
      const activar=()=>{
        const i = parseInt(lado.dataset.lado,10);
        if(lado.classList.contains('lado-correcto')) return;
        if(seleccionado===null){
          seleccionado=lado; lado.classList.add('lado-seleccionado');
          return;
        }
        const j = parseInt(seleccionado.dataset.lado,10);
        if(i===j){ seleccionado=null; lado.classList.remove('lado-seleccionado'); return; }
        const esPar = fig.paresParalelos.some(par=> (par[0]===i&&par[1]===j) || (par[0]===j&&par[1]===i));
        if(esPar){
          seleccionado.classList.remove('lado-seleccionado');
          seleccionado.classList.add('lado-correcto');
          lado.classList.add('lado-correcto');
          seleccionado=null; encontrados++;
          cuentaEl.textContent = `Pares encontrados: ${encontrados} de ${fig.paresParalelos.length}`;
          mostrarFeedback(fb,'ok','¡Sí! Esos lados son paralelos.');
          if(encontrados===fig.paresParalelos.length){ marcarCompletada(idTarjeta); habilitarBotonSiguiente(container); }
        } else {
          mostrarFeedback(fb,'bad','Esos lados no van igual. Mirá otra vez.');
          seleccionado.classList.remove('lado-seleccionado');
          seleccionado=null;
        }
      };
      lado.addEventListener('click', activar);
      lado.addEventListener('keydown', e=>{ if(e.key==='Enter'||e.key===' '){e.preventDefault();activar();} });
    });
    container.querySelector('[data-a="escuchar"]').addEventListener('click', ()=> hablar(consigna));
    container.querySelector('[data-a="pista"]').addEventListener('click', ()=>{
      if(pistasUsadas>=2){ mostrarFeedback(fb,'hint','Ya usaste las 2 pistas.'); return; }
      mostrarFeedback(fb,'hint', pistasUsadas===0 ? 'Los lados paralelos nunca se juntan, van siempre separados igual.' : 'Fijate cuáles lados están uno arriba y uno abajo, bien derechitos.');
      pistasUsadas++; container.querySelector('[data-hl]').textContent=(2-pistasUsadas);
    });
  };
}

/* Botón "Siguiente" que aparece al resolver la tarjeta */
function habilitarBotonSiguiente(container){
  if(container.querySelector('#btn-siguiente')) return;
  const fila=document.createElement('div');
  fila.className='actions-row';
  fila.innerHTML = `<button class="btn-accent btn-grande" id="btn-siguiente">➡️ Siguiente</button>`;
  container.appendChild(fila);
  document.getElementById('btn-siguiente').addEventListener('click', irSiguienteTarjeta);
  hablar('Muy bien. Tocá siguiente para continuar.');
}

/* ================================================================
   LISTA DE LAS 12 TARJETAS EN ORDEN
   ================================================================ */
const TARJETAS = [
  { id:'t1', construir: tarjetaArrastrarNombre('t1','paralelogramo', ['paralelogramo','rombo','cuadrado']) },
  { id:'t2', construir: tarjetaArrastrarNombre('t2','rectangulo', ['rectángulo','cuadrado','rombo']) },
  { id:'t3', construir: tarjetaArrastrarNombre('t3','rombo', ['rombo','cuadrado','paralelogramo']) },
  { id:'t4', construir: tarjetaArrastrarNombre('t4','cuadrado', ['cuadrado','rectángulo','rombo']) },
  { id:'t5', construir: tarjetaArrastrarNombre('t5','trapecioIsosceles', ['trapecio isósceles','trapecio rectángulo','trapecio escaleno']) },
  { id:'t6', construir: tarjetaArrastrarNombre('t6','trapecioRectangulo', ['trapecio rectángulo','trapecio isósceles','trapecio escaleno']) },
  { id:'t7', construir: tarjetaArrastrarNombre('t7','trapecioEscaleno', ['trapecio escaleno','trapecio isósceles','trapecio rectángulo']) },
  { id:'t8', construir: tarjetaClasificar('t8') },
