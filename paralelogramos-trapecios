}
footer{max-width:820px;margin:1rem auto;padding:0 .8rem 2rem;color:var(--muted);font-size:.85rem;text-align:center;}

.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
</style>
