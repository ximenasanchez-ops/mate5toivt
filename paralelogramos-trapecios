/* ================================================================
   6. NAVEGACIÓN, PROGRESO, TEMPORIZADOR
   ================================================================ */
function mostrarPantalla(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}
function actualizarProgreso(){
  const total = TARJETAS.length;
  const hechas = Object.keys(ESTADO.completadas).length;
  document.getElementById('progress-fill').style.width = (100*hechas/total)+'%';
}
function irTarjeta(indice){
  ESTADO.tarjetaActual = indice;
  const cont = document.getElementById('actividad-container');
  cont.innerHTML='';
  document.getElementById('tarjeta-num').textContent = `Tarjeta ${indice+1} de ${TARJETAS.length}`;
  TARJETAS[indice].construir(cont);
  actualizarProgreso();
  mostrarPantalla('screen-actividad');
  window.scrollTo({top:0, behavior:'smooth'});
}
function irSiguienteTarjeta(){
  if(ESTADO.tarjetaActual < TARJETAS.length-1){
    irTarjeta(ESTADO.tarjetaActual+1);
  } else {
    mostrarFinal();
  }
}

let segundos=0, intervaloTiempo=null;
function formatoTiempo(s){ const m=Math.floor(s/60).toString().padStart(2,'0'); const ss=(s%60).toString().padStart(2,'0'); return `${m}:${ss}`; }
function iniciarTiempo(){
  if(intervaloTiempo) return;
  intervaloTiempo = setInterval(()=>{
    segundos++;
    document.getElementById('footer-tiempo').textContent = formatoTiempo(segundos);
  },1000);
}
function reiniciarTiempo(){ segundos=0; document.getElementById('footer-tiempo').textContent='00:00'; }

document.getElementById('btn-empezar').addEventListener('click', ()=>{
  ESTADO.completadas={};
  iniciarTiempo();
  irTarjeta(0);
});
document.getElementById('btn-otra-vez').addEventListener('click', ()=>{
  ESTADO.completadas={};
  reiniciarTiempo(); iniciarTiempo();
  irTarjeta(0);
});
document.getElementById('btn-volver-inicio').addEventListener('click', ()=>{
  clearInterval(intervaloTiempo); intervaloTiempo=null;
  mostrarPantalla('screen-inicio');
});

function mostrarFinal(){
  clearInterval(intervaloTiempo); intervaloTiempo=null;
  document.getElementById('final-tiempo').textContent = formatoTiempo(segundos);
  const hechas = Object.keys(ESTADO.completadas).length;
  const msg = hechas===TARJETAS.length
    ? '¡Hiciste todas las actividades! Estás aprendiendo muy bien las figuras.'
    : `¡Muy bien! Completaste ${hechas} de ${TARJETAS.length} actividades.`;
  document.getElementById('final-msg').textContent = msg;
  hablar('¡Terminaste! '+msg);
  mostrarPantalla('screen-final');
}

/* ================================================================
   7. CONTROLES DE ACCESIBILIDAD (voz, tamaño de letra, contraste)
   ================================================================ */
let tamanoFuente = CONFIG.FUENTE_INICIAL_PX;
function aplicarFuente(){ document.documentElement.style.setProperty('--fs-base', tamanoFuente+'px'); }
document.getElementById('btn-mas').addEventListener('click', ()=>{ tamanoFuente=Math.min(tamanoFuente+2,32); aplicarFuente(); });
document.getElementById('btn-menos').addEventListener('click', ()=>{ tamanoFuente=Math.max(tamanoFuente-2,16); aplicarFuente(); });

document.getElementById('btn-contraste').addEventListener('click', function(){
  const activo = document.body.classList.toggle('alto-contraste');
  this.setAttribute('aria-pressed', String(activo));
});

document.getElementById('btn-voz').addEventListener('click', function(){
  vozActivada = !vozActivada;
  this.setAttribute('aria-pressed', String(vozActivada));
  this.textContent = vozActivada ? '🔊 Voz' : '🔇 Voz';
  if(!vozActivada && 'speechSynthesis' in window) window.speechSynthesis.cancel();
});

/* ================================================================
   8. GUARDAR / CONTINUAR (localStorage)
   ================================================================ */
const LS_KEY = 'jugamosConFigurasProgreso';
document.getElementById('btn-guardar').addEventListener('click', ()=>{
  try{
    localStorage.setItem(LS_KEY, JSON.stringify({ tarjeta:ESTADO.tarjetaActual, completadas:ESTADO.completadas, segundos }));
    alert('Guardado. La próxima vez tocá "Continuar donde quedé".');
  }catch(e){ alert('No se pudo guardar en este navegador.'); }
});
document.getElementById('btn-continuar-inicio').addEventListener('click', ()=>{
  const raw = localStorage.getItem(LS_KEY);
  if(!raw){ alert('Todavía no hay nada guardado.'); return; }
  try{
    const data = JSON.parse(raw);
    ESTADO.completadas = data.completadas || {};
    segundos = data.segundos || 0;
    document.getElementById('footer-tiempo').textContent = formatoTiempo(segundos);
    iniciarTiempo();
    irTarjeta(data.tarjeta || 0);
  }catch(e){ alert('No se pudo leer lo guardado.'); }
});

/* Estado inicial de accesibilidad */
aplicarFuente();
document.getElementById('btn-voz').setAttribute('aria-pressed', String(vozActivada));
if(!vozActivada) document.getElementById('btn-voz').textContent = '🔇 Voz';
</script>
