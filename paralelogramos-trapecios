  <h3>INSTITUTO VISIÓN TECNOLÓGICA - Matemática 5to</h3>

<script>
/* ================================================================================
   JUGAMOS CON FIGURAS — LÓGICA
   Secciones:
     0. CONFIG              → todo lo que el docente puede ajustar fácil
     1. GEOMETRÍA DE FIGURAS → puntos de cada una de las 7 figuras + lados paralelos
     2. DIBUJO SVG            → función que dibuja una figura
     3. VOZ (texto a voz)
     4. UTILIDADES DE ARRASTRE (pointer events, mouse + táctil)
     5. LAS 12 TARJETAS DE ACTIVIDAD
     6. NAVEGACIÓN, PROGRESO, TEMPORIZADOR
     7. GUARDAR / CONTINUAR (localStorage)
   ================================================================================ */

/* ---------------------------------------------------------------
   0. CONFIG — el profesor puede cambiar esto
   --------------------------------------------------------------- */
const CONFIG = {
  TIEMPO_ESTIMADO_MIN: 30,      // solo informativo, no genera alarma ni presión
  FUENTE_INICIAL_PX: 20,        // tamaño de letra inicial
  VOZ_ACTIVADA_INICIO: true,    // si la voz arranca prendida o apagada
  IDIOMA_VOZ: 'es-ES',          // también podés probar 'es-AR', 'es-MX', etc.
  TEXTO_PISTA_GENERAL_1: 'Mirá bien los lados de la figura.',
  TEXTO_PISTA_GENERAL_2: 'Tocá otra vez, con calma. ¡Vos podés!',
};

/* ---------------------------------------------------------------
   1. GEOMETRÍA DE LAS 7 FIGURAS
   Cada figura tiene 4 puntos (vértices) en un cuadro de 220x160.
   Los "lados" son: lado0 = punto0-punto1, lado1 = punto1-punto2,
   lado2 = punto2-punto3, lado3 = punto3-punto0.
   "paresParalelos" indica qué lados van en la misma dirección.
   --------------------------------------------------------------- */
const FIGURAS = {
  paralelogramo: {
    nombre: 'paralelogramo',
    grupo: 'Paralelogramo',
    puntos: [[30,130],[150,130],[190,40],[70,40]],
    paresParalelos: [[0,2],[1,3]],
  },
  rectangulo: {
    nombre: 'rectángulo',
    grupo: 'Paralelogramo',
    puntos: [[40,120],[180,120],[180,40],[40,40]],
    paresParalelos: [[0,2],[1,3]],
  },
  rombo: {
    nombre: 'rombo',
    grupo: 'Paralelogramo',
    puntos: [[110,20],[190,80],[110,150],[30,80]],
    paresParalelos: [[0,2],[1,3]],
  },
  cuadrado: {
    nombre: 'cuadrado',
    grupo: 'Paralelogramo',
    puntos: [[50,20],[170,20],[170,140],[50,140]],
    paresParalelos: [[0,2],[1,3]],
  },
  trapecioIsosceles: {
    nombre: 'trapecio isósceles',
    grupo: 'Trapecio',
    puntos: [[50,130],[170,130],[150,40],[70,40]],
    paresParalelos: [[0,2]],
  },
  trapecioRectangulo: {
    nombre: 'trapecio rectángulo',
    grupo: 'Trapecio',
    puntos: [[40,130],[160,130],[160,40],[70,40]],
    paresParalelos: [[0,2]],
  },
  trapecioEscaleno: {
    nombre: 'trapecio escaleno',
    grupo: 'Trapecio',
    puntos: [[30,130],[180,130],[160,45],[80,45]],
    paresParalelos: [[0,2]],
  },
};
const LISTA_FIGURAS = Object.keys(FIGURAS);

/* ---------------------------------------------------------------
   2. DIBUJO SVG DE UNA FIGURA
   --------------------------------------------------------------- */
function puntosAStr(puntos){ return puntos.map(p=>p.join(',')).join(' '); }

// Dibuja el polígono. `opciones.ladosClickables` = true habilita marcar lados.
// `opciones.resaltarPares` = true pinta directamente los pares paralelos (para mostrar solución).
function dibujarFiguraSVG(idFigura, opciones={}){
  const fig = FIGURAS[idFigura];
  const p = fig.puntos;
  let lados = '';
  for(let i=0;i<4;i++){
    const a=p[i], b=p[(i+1)%4];
    const claseExtra = opciones.ladosClickables ? 'lado-clickable' : '';
    let colorExtra = '';
    if(opciones.resaltarPares){
      // color distinto por cada par paralelo
      const parIdx = fig.paresParalelos.findIndex(par=>par.includes(i));
      if(parIdx===0) colorExtra='stroke="#1fa15a" stroke-width="7"';
      if(parIdx===1) colorExtra='stroke="#d6551d" stroke-width="7"';
    }
    lados += `<line data-lado="${i}" class="${claseExtra}" x1="${a[0]}" y1="${a[1]}" x2="${b[0]}" y2="${b[1]}" stroke="#132038" stroke-width="5" stroke-linecap="round" ${colorExtra}></line>`;
  }
  const idSvg = 'svg-'+Math.random().toString(36).slice(2,9);
  return `<svg id="${idSvg}" class="figura-svg" viewBox="0 0 220 160" role="img" aria-label="Figura: ${fig.nombre}">
    <polygon points="${puntosAStr(p)}" fill="#cfe3ff" fill-opacity="0.5" stroke="none"></polygon>
    ${lados}
  </svg>`;
}

/* ---------------------------------------------------------------
   3. VOZ (texto a voz), muy simple
   --------------------------------------------------------------- */
let vozActivada = CONFIG.VOZ_ACTIVADA_INICIO;
function hablar(texto){
  if(!vozActivada) return;
  try{
    if(!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(texto);
    u.lang = CONFIG.IDIOMA_VOZ;
    u.rate = 0.95;
    window.speechSynthesis.speak(u);
  }catch(e){ /* si el navegador no soporta voz, seguimos sin voz */ }
}

/* ---------------------------------------------------------------
   4. UTILIDADES DE ARRASTRE (pointer events: funciona con mouse y dedo)
   `onDrop(elementoArrastrado, elementoDestino)` se llama al soltar
   encima de un destino válido (con clase "dnd-destino").
   --------------------------------------------------------------- */
function habilitarArrastre(origenSelector, destinoSelector, onDrop, contenedor){
  contenedor.querySelectorAll(origenSelector).forEach(el=>{
    el.addEventListener('pointerdown', (e)=>{
      if(el.dataset.colocado==='1') return;
      const rect = el.getBoundingClientRect();
      const offsetX = e.clientX-rect.left, offsetY = e.clientY-rect.top;
      const anchoOriginal = rect.width;
      el.setPointerCapture(e.pointerId);
      el.classList.add('dragging');
      el.style.width = anchoOriginal+'px';
      el.style.left = rect.left+'px'; el.style.top = rect.top+'px';

      function mover(ev){
        el.style.left=(ev.clientX-offsetX)+'px';
        el.style.top=(ev.clientY-offsetY)+'px';
        contenedor.querySelectorAll(destinoSelector).forEach(d=>d.classList.remove('sobre'));
        const bajo = document.elementFromPoint(ev.clientX, ev.clientY);
        const destino = bajo && bajo.closest ? bajo.closest(destinoSelector) : null;
        if(destino) destino.classList.add('sobre');
      }
      function soltar(ev){
        document.removeEventListener('pointermove', mover);
        document.removeEventListener('pointerup', soltar);
        el.classList.remove('dragging');
        el.style.position=''; el.style.left=''; el.style.top=''; el.style.width='';
        contenedor.querySelectorAll(destinoSelector).forEach(d=>d.classList.remove('sobre'));
        const bajo = document.elementFromPoint(ev.clientX, ev.clientY);
        const destino = bajo && bajo.closest ? bajo.closest(destinoSelector) : null;
        if(destino) onDrop(el, destino);
      }
      document.addEventListener('pointermove', mover);
      document.addEventListener('pointerup', soltar);
    });
    // Alternativa por teclado: Enter selecciona, y luego Enter en el destino coloca.
    el.tabIndex = 0;
    el.setAttribute('role','button');
    el.addEventListener('keydown', (e)=>{
      if(e.key!=='Enter' && e.key!==' ') return;
      e.preventDefault();
      if(el.dataset.colocado==='1') return;
      const destinos=[...contenedor.querySelectorAll(destinoSelector)].filter(d=>d.dataset.lleno!=='1');
      if(destinos.length) onDrop(el, destinos[0]);
    });
  });
}

