body.alto-contraste .opcion-btn{background:#000;color:var(--primary);}
body.alto-contraste .opcion-btn.correcta{background:#003d17;color:#fff;}

.opciones-imagen{display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;}
.opcion-imagen{
  background:var(--panel);border:3px solid var(--border);border-radius:14px;padding:.6rem;
  cursor:pointer;width:150px;
}
.opcion-imagen:hover{border-color:var(--primary);}
.opcion-imagen.correcta{border-color:var(--accent);background:#e0f7e9;}
